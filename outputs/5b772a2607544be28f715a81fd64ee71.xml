  <body>
    <p>Ten Complex Mathematical Formulas</p>
    <p>
      1.
      <bold> Euler’s Identity</bold>
       
      <inline-formula>
        <mml:math display="inline">
          <mml:mrow>
            <mml:msup>
              <mml:mi>e</mml:mi>
              <mml:mrow>
                <mml:mi>i</mml:mi>
                <mml:mi>π</mml:mi>
              </mml:mrow>
            </mml:msup>
            <mml:mo>+</mml:mo>
            <mml:mn>1</mml:mn>
            <mml:mo>=</mml:mo>
            <mml:mn>0</mml:mn>
          </mml:mrow>
        </mml:math>
      </inline-formula>
    </p>
    <p>
      2.
      <bold> Gaussian Integral</bold>
       
      <inline-formula>
        <mml:math display="inline">
          <mml:mrow>
            <mml:msubsup>
              <mml:mo>∫</mml:mo>
              <mml:mrow>
                <mml:mo>−</mml:mo>
                <mml:mo>∞</mml:mo>
              </mml:mrow>
              <mml:mo>∞</mml:mo>
            </mml:msubsup>
            <mml:msup>
              <mml:mi>e</mml:mi>
              <mml:mrow>
                <mml:mo>−</mml:mo>
                <mml:msup>
                  <mml:mi>x</mml:mi>
                  <mml:mn>2</mml:mn>
                </mml:msup>
              </mml:mrow>
            </mml:msup>
            <mml:mrow>
              <mml:mi>d</mml:mi>
              <mml:mi>x</mml:mi>
            </mml:mrow>
            <mml:mo>=</mml:mo>
            <mml:msqrt>
              <mml:mi>π</mml:mi>
            </mml:msqrt>
          </mml:mrow>
        </mml:math>
      </inline-formula>
    </p>
    <sec>
      <title>3.  Basel Problem (Riemann Zeta at 2)</title>
      <p>
        <inline-formula>
          <mml:math display="inline">
            <mml:mrow>
              <mml:munderover>
                <mml:mo>∑</mml:mo>
                <mml:mrow>
                  <mml:mi>n</mml:mi>
                  <mml:mo>=</mml:mo>
                  <mml:mn>1</mml:mn>
                </mml:mrow>
                <mml:mo>∞</mml:mo>
              </mml:munderover>
              <mml:mfrac>
                <mml:mn>1</mml:mn>
                <mml:msup>
                  <mml:mi>n</mml:mi>
                  <mml:mn>2</mml:mn>
                </mml:msup>
              </mml:mfrac>
              <mml:mo>=</mml:mo>
              <mml:mfrac>
                <mml:msup>
                  <mml:mi>π</mml:mi>
                  <mml:mn>2</mml:mn>
                </mml:msup>
                <mml:mn>6</mml:mn>
              </mml:mfrac>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
      <p>
        4.
        <bold> Stirling’s Approximation</bold>
         
        <inline-formula>
          <mml:math display="inline">
            <mml:mrow>
              <mml:mi>n</mml:mi>
              <mml:mo>!</mml:mo>
              <mml:mo>≈</mml:mo>
              <mml:msqrt>
                <mml:mn>2</mml:mn>
              </mml:msqrt>
              <mml:mi>π</mml:mi>
              <mml:mi>n</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mfrac>
                <mml:mi>n</mml:mi>
                <mml:mi>e</mml:mi>
              </mml:mfrac>
              <mml:mo>)</mml:mo>
              <mml:mi>n</mml:mi>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
      <p>
        5.
        <bold> Fourier Transform</bold>
         ˆ 
        <inline-formula>
          <mml:math display="inline">
            <mml:mrow>
              <mml:mi>f</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mi>ξ</mml:mi>
              <mml:mo>)</mml:mo>
              <mml:mo>=</mml:mo>
              <mml:msubsup>
                <mml:mo>∫</mml:mo>
                <mml:mrow>
                  <mml:mo>−</mml:mo>
                  <mml:mo>∞</mml:mo>
                </mml:mrow>
                <mml:mo>∞</mml:mo>
              </mml:msubsup>
              <mml:mi>f</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mi>x</mml:mi>
              <mml:mo>)</mml:mo>
              <mml:msup>
                <mml:mi>e</mml:mi>
                <mml:mrow>
                  <mml:mo>−</mml:mo>
                  <mml:mn>2</mml:mn>
                  <mml:mi>π</mml:mi>
                  <mml:mrow>
                    <mml:mi>i</mml:mi>
                    <mml:mi>x</mml:mi>
                  </mml:mrow>
                  <mml:mi>ξ</mml:mi>
                </mml:mrow>
              </mml:msup>
              <mml:mrow>
                <mml:mi>d</mml:mi>
                <mml:mi>x</mml:mi>
              </mml:mrow>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
    </sec>
    <sec>
      <title>6.  Cauchy Integral Formula</title>
      <p>
        <inline-formula>
          <mml:math display="inline">
            <mml:mrow>
              <mml:msub>
                <mml:mo>∮</mml:mo>
                <mml:mi>γ</mml:mi>
              </mml:msub>
              <mml:mi>f</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mi>a</mml:mi>
              <mml:mo>)</mml:mo>
              <mml:mo>=</mml:mo>
              <mml:mfrac>
                <mml:mn>1</mml:mn>
                <mml:mrow>
                  <mml:mn>2</mml:mn>
                  <mml:mi>π</mml:mi>
                  <mml:mi>i</mml:mi>
                </mml:mrow>
              </mml:mfrac>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
      <p>
        <inline-formula>
          <mml:math display="inline">
            <mml:mrow>
              <mml:mfrac>
                <mml:mrow>
                  <mml:mi>f</mml:mi>
                  <mml:mo>(</mml:mo>
                  <mml:mi>z</mml:mi>
                  <mml:mo>)</mml:mo>
                </mml:mrow>
                <mml:mrow>
                  <mml:mi>z</mml:mi>
                  <mml:mo>−</mml:mo>
                  <mml:mi>a</mml:mi>
                </mml:mrow>
              </mml:mfrac>
              <mml:mrow>
                <mml:mi>d</mml:mi>
                <mml:mi>z</mml:mi>
              </mml:mrow>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
    </sec>
    <sec>
      <title>7.  Schr¨ odinger Equation (time-dependent)</title>
      <p>
        <inline-formula>
          <mml:math display="inline">
            <mml:mrow>
              <mml:mi>Ψ</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mi>r</mml:mi>
              <mml:mo>,</mml:mo>
              <mml:mi>t</mml:mi>
              <mml:mo>)</mml:mo>
              <mml:mo>=</mml:mo>
              <mml:mo>(</mml:mo>
              <mml:mo>−</mml:mo>
              <mml:mfrac>
                <mml:msup>
                  <mml:mi>ℏ</mml:mi>
                  <mml:mn>2</mml:mn>
                </mml:msup>
                <mml:mrow>
                  <mml:mn>2</mml:mn>
                  <mml:mi>m</mml:mi>
                </mml:mrow>
              </mml:mfrac>
              <mml:msup>
                <mml:mo>∇</mml:mo>
                <mml:mn>2</mml:mn>
              </mml:msup>
              <mml:mo>+</mml:mo>
              <mml:mi>V</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mi>r</mml:mi>
              <mml:mo>,</mml:mo>
              <mml:mi>t</mml:mi>
              <mml:mo>)</mml:mo>
              <mml:mo>)</mml:mo>
              <mml:mi>Ψ</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mi>r</mml:mi>
              <mml:mo>,</mml:mo>
              <mml:mi>t</mml:mi>
              <mml:mo>)</mml:mo>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
      <p>
        <inline-formula>
          <mml:math display="inline">
            <mml:mrow>
              <mml:mi>i</mml:mi>
              <mml:mi>ℏ</mml:mi>
              <mml:mfrac>
                <mml:mo>∂</mml:mo>
                <mml:mrow>
                  <mml:mo>∂</mml:mo>
                  <mml:mi>t</mml:mi>
                </mml:mrow>
              </mml:mfrac>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
    </sec>
    <sec>
      <title>8.  Riemann Zeta Function (functional equation)</title>
      <p>
        <inline-formula>
          <mml:math display="inline">
            <mml:mrow>
              <mml:mi>ζ</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mi>s</mml:mi>
              <mml:mo>)</mml:mo>
              <mml:mo>=</mml:mo>
              <mml:msup>
                <mml:mn>2</mml:mn>
                <mml:mi>s</mml:mi>
              </mml:msup>
              <mml:msup>
                <mml:mi>π</mml:mi>
                <mml:mrow>
                  <mml:mi>s</mml:mi>
                  <mml:mo>−</mml:mo>
                  <mml:mn>1</mml:mn>
                </mml:mrow>
              </mml:msup>
              <mml:mi mathvariant="normal">sin</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mfrac>
                <mml:mrow>
                  <mml:mi>π</mml:mi>
                  <mml:mi>s</mml:mi>
                </mml:mrow>
                <mml:mn>2</mml:mn>
              </mml:mfrac>
              <mml:mo>)</mml:mo>
              <mml:mi>Γ</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mn>1</mml:mn>
              <mml:mo>−</mml:mo>
              <mml:mi>s</mml:mi>
              <mml:mo>)</mml:mo>
              <mml:mi>ζ</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mn>1</mml:mn>
              <mml:mo>−</mml:mo>
              <mml:mi>s</mml:mi>
              <mml:mo>)</mml:mo>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
    </sec>
    <sec>
      <title>9.  Navier–Stokes Equation (incompressible flow)</title>
      <p>
        <inline-formula>
          <mml:math display="inline">
            <mml:mrow>
              <mml:mi>ρ</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mfrac>
                <mml:mrow>
                  <mml:mo>∂</mml:mo>
                  <mml:mi>u</mml:mi>
                </mml:mrow>
                <mml:mrow>
                  <mml:mo>∂</mml:mo>
                  <mml:mi>t</mml:mi>
                </mml:mrow>
              </mml:mfrac>
              <mml:mo>+</mml:mo>
              <mml:mi>u</mml:mi>
              <mml:mo>·</mml:mo>
              <mml:mo>∇</mml:mo>
              <mml:mi>u</mml:mi>
              <mml:mo>)</mml:mo>
              <mml:mo>=</mml:mo>
              <mml:mo>−</mml:mo>
              <mml:mo>∇</mml:mo>
              <mml:mi>p</mml:mi>
              <mml:mo>+</mml:mo>
              <mml:mi>µ</mml:mi>
              <mml:msup>
                <mml:mo>∇</mml:mo>
                <mml:mn>2</mml:mn>
              </mml:msup>
              <mml:mi>u</mml:mi>
              <mml:mo>+</mml:mo>
              <mml:mi>f</mml:mi>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
    </sec>
    <sec>
      <title>10.  Einstein Field Equations</title>
      <p>
        <inline-formula>
          <mml:math display="inline">
            <mml:mrow>
              <mml:msub>
                <mml:mi>G</mml:mi>
                <mml:mrow>
                  <mml:mi>µ</mml:mi>
                  <mml:mi>ν</mml:mi>
                </mml:mrow>
              </mml:msub>
              <mml:mo>+</mml:mo>
              <mml:mi>Λ</mml:mi>
              <mml:msub>
                <mml:mi>g</mml:mi>
                <mml:mrow>
                  <mml:mi>µ</mml:mi>
                  <mml:mi>ν</mml:mi>
                </mml:mrow>
              </mml:msub>
              <mml:mo>=</mml:mo>
              <mml:mfrac>
                <mml:mrow>
                  <mml:mn>8</mml:mn>
                  <mml:mi>π</mml:mi>
                  <mml:mi>G</mml:mi>
                </mml:mrow>
                <mml:msup>
                  <mml:mi>c</mml:mi>
                  <mml:mn>4</mml:mn>
                </mml:msup>
              </mml:mfrac>
              <mml:msup>
                <mml:mi>T</mml:mi>
                <mml:mrow>
                  <mml:mi>µ</mml:mi>
                  <mml:mi>ν</mml:mi>
                </mml:mrow>
              </mml:msup>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
    </sec>
