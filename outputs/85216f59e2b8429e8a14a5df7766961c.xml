  <body>
    <p>Ten Complex Mathematical Formulas</p>
    <p>
      1.
      <bold> Euler’s Identity</bold>
       
      <inline-formula>
        <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
          <mrow>
            <msup>
              <mi>e</mi>
              <mrow>
                <mi>i</mi>
                <mi>π</mi>
              </mrow>
            </msup>
            <mo>+</mo>
            <mn>1</mn>
            <mo>=</mo>
            <mn>0</mn>
          </mrow>
        </math>
      </inline-formula>
    </p>
    <p>
      2.
      <bold> Gaussian Integral</bold>
       
      <inline-formula>
        <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
          <mrow>
            <msubsup>
              <mo>∫</mo>
              <mrow>
                <mo>−</mo>
                <mo>∞</mo>
              </mrow>
              <mo>∞</mo>
            </msubsup>
            <msup>
              <mi>e</mi>
              <mrow>
                <mo>−</mo>
                <msup>
                  <mi>x</mi>
                  <mn>2</mn>
                </msup>
              </mrow>
            </msup>
            <mrow>
              <mi>d</mi>
              <mi>x</mi>
            </mrow>
            <mo>=</mo>
            <msqrt>
              <mi>π</mi>
            </msqrt>
          </mrow>
        </math>
      </inline-formula>
    </p>
    <sec>
      <title>3.  Basel Problem (Riemann Zeta at 2)</title>
      <p>
        <inline-formula>
          <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
            <mrow>
              <munderover>
                <mo>∑</mo>
                <mrow>
                  <mi>n</mi>
                  <mo>=</mo>
                  <mn>1</mn>
                </mrow>
                <mo>∞</mo>
              </munderover>
              <mfrac>
                <mn>1</mn>
                <msup>
                  <mi>n</mi>
                  <mn>2</mn>
                </msup>
              </mfrac>
              <mo>=</mo>
              <mfrac>
                <msup>
                  <mi>π</mi>
                  <mn>2</mn>
                </msup>
                <mn>6</mn>
              </mfrac>
            </mrow>
          </math>
        </inline-formula>
      </p>
      <p>
        4.
        <bold> Stirling’s Approximation</bold>
         
        <inline-formula>
          <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
            <mrow>
              <mi>n</mi>
              <mo>!</mo>
              <mo>≈</mo>
              <msqrt>
                <mrow>
                  <mn>2</mn>
                  <mi>π</mi>
                  <mi>n</mi>
                </mrow>
              </msqrt>
              <mo>(</mo>
              <mfrac>
                <mi>n</mi>
                <mi>e</mi>
              </mfrac>
              <mo>)</mo>
              <mi>n</mi>
            </mrow>
          </math>
        </inline-formula>
      </p>
      <p>
        5.
        <bold> Fourier Transform</bold>
         
        <inline-formula>
          <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
            <mrow>
              <mover accent="true">
                <mi>f</mi>
                <mo>^</mo>
              </mover>
              <mo>(</mo>
              <mi>ξ</mi>
              <mo>)</mo>
              <mo>=</mo>
              <msubsup>
                <mo>∫</mo>
                <mrow>
                  <mo>−</mo>
                  <mo>∞</mo>
                </mrow>
                <mo>∞</mo>
              </msubsup>
              <mi>f</mi>
              <mo>(</mo>
              <mi>x</mi>
              <mo>)</mo>
              <msup>
                <mi>e</mi>
                <mrow>
                  <mo>−</mo>
                  <mn>2</mn>
                  <mi>π</mi>
                  <mrow>
                    <mi>i</mi>
                    <mi>x</mi>
                  </mrow>
                  <mi>ξ</mi>
                </mrow>
              </msup>
              <mrow>
                <mi>d</mi>
                <mi>x</mi>
              </mrow>
            </mrow>
          </math>
        </inline-formula>
      </p>
    </sec>
    <sec>
      <title>6.  Cauchy Integral Formula</title>
      <p>
        <inline-formula>
          <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
            <mrow>
              <msub>
                <mo>∮</mo>
                <mi>γ</mi>
              </msub>
              <mi>f</mi>
              <mo>(</mo>
              <mi>a</mi>
              <mo>)</mo>
              <mo>=</mo>
              <mfrac>
                <mn>1</mn>
                <mrow>
                  <mn>2</mn>
                  <mi>π</mi>
                  <mi>i</mi>
                </mrow>
              </mfrac>
              <mfrac>
                <mrow>
                  <mi>f</mi>
                  <mo>(</mo>
                  <mi>z</mi>
                  <mo>)</mo>
                </mrow>
                <mrow>
                  <mi>z</mi>
                  <mo>−</mo>
                  <mi>a</mi>
                </mrow>
              </mfrac>
              <mrow>
                <mi>d</mi>
                <mi>z</mi>
              </mrow>
            </mrow>
          </math>
        </inline-formula>
      </p>
    </sec>
    <sec>
      <title>7.  Schr¨ odinger Equation (time-dependent)</title>
      <p>
        <inline-formula>
          <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
            <mrow>
              <mi>Ψ</mi>
              <mo>(</mo>
              <mi>r</mi>
              <mo>,</mo>
              <mi>t</mi>
              <mo>)</mo>
              <mo>=</mo>
              <mo>(</mo>
              <mo>−</mo>
              <mfrac>
                <msup>
                  <mi>ℏ</mi>
                  <mn>2</mn>
                </msup>
                <mrow>
                  <mn>2</mn>
                  <mi>m</mi>
                </mrow>
              </mfrac>
              <msup>
                <mo>∇</mo>
                <mn>2</mn>
              </msup>
              <mo>+</mo>
              <mi>V</mi>
              <mo>(</mo>
              <mi>r</mi>
              <mo>,</mo>
              <mi>t</mi>
              <mo>)</mo>
              <mo>)</mo>
              <mi>Ψ</mi>
              <mo>(</mo>
              <mi>r</mi>
              <mo>,</mo>
              <mi>t</mi>
              <mo>)</mo>
              <mi>i</mi>
              <mi>ℏ</mi>
              <mfrac>
                <mo>∂</mo>
                <mrow>
                  <mo>∂</mo>
                  <mi>t</mi>
                </mrow>
              </mfrac>
            </mrow>
          </math>
        </inline-formula>
      </p>
    </sec>
    <sec>
      <title>8.  Riemann Zeta Function (functional equation)</title>
      <p>
        <inline-formula>
          <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
            <mrow>
              <mi>ζ</mi>
              <mo>(</mo>
              <mi>s</mi>
              <mo>)</mo>
              <mo>=</mo>
              <msup>
                <mn>2</mn>
                <mi>s</mi>
              </msup>
              <msup>
                <mi>π</mi>
                <mrow>
                  <mi>s</mi>
                  <mo>−</mo>
                  <mn>1</mn>
                </mrow>
              </msup>
              <mi mathvariant="normal">sin</mi>
              <mo>(</mo>
              <mfrac>
                <mrow>
                  <mi>π</mi>
                  <mi>s</mi>
                </mrow>
                <mn>2</mn>
              </mfrac>
              <mo>)</mo>
              <mi>Γ</mi>
              <mo>(</mo>
              <mn>1</mn>
              <mo>−</mo>
              <mi>s</mi>
              <mo>)</mo>
              <mi>ζ</mi>
              <mo>(</mo>
              <mn>1</mn>
              <mo>−</mo>
              <mi>s</mi>
              <mo>)</mo>
            </mrow>
          </math>
        </inline-formula>
      </p>
    </sec>
    <sec>
      <title>9.  Navier–Stokes Equation (incompressible flow)</title>
      <p>
        <inline-formula>
          <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
            <mrow>
              <mi>ρ</mi>
              <mo>(</mo>
              <mfrac>
                <mrow>
                  <mo>∂</mo>
                  <mi>u</mi>
                </mrow>
                <mrow>
                  <mo>∂</mo>
                  <mi>t</mi>
                </mrow>
              </mfrac>
              <mo>+</mo>
              <mi>u</mi>
              <mo>·</mo>
              <mo>∇</mo>
              <mi>u</mi>
              <mo>)</mo>
              <mo>=</mo>
              <mo>−</mo>
              <mo>∇</mo>
              <mi>p</mi>
              <mo>+</mo>
              <mi>µ</mi>
              <msup>
                <mo>∇</mo>
                <mn>2</mn>
              </msup>
              <mi>u</mi>
              <mo>+</mo>
              <mi>f</mi>
            </mrow>
          </math>
        </inline-formula>
      </p>
    </sec>
    <sec>
      <title>10.  Einstein Field Equations</title>
      <p>
        <inline-formula>
          <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
            <mrow>
              <msub>
                <mi>G</mi>
                <mrow>
                  <mi>µ</mi>
                  <mi>ν</mi>
                </mrow>
              </msub>
              <mo>+</mo>
              <mi>Λ</mi>
              <msub>
                <mi>g</mi>
                <mrow>
                  <mi>µ</mi>
                  <mi>ν</mi>
                </mrow>
              </msub>
              <mo>=</mo>
              <mfrac>
                <mrow>
                  <mn>8</mn>
                  <mi>π</mi>
                  <mi>G</mi>
                </mrow>
                <msup>
                  <mi>c</mi>
                  <mn>4</mn>
                </msup>
              </mfrac>
              <msup>
                <mi>T</mi>
                <mrow>
                  <mi>µ</mi>
                  <mi>ν</mi>
                </mrow>
              </msup>
            </mrow>
          </math>
        </inline-formula>
      </p>
    </sec>
