  <body>
    <p>Ten Complex Mathematical Formulas</p>
    <p>
      1.
      <bold> Euler’s Identity</bold>
       
      <inline-formula>
        <tex-math>e^{iπ}+ 1 = 0</tex-math>
        <mml:math display="inline">
          <mml:mrow>
            <mml:msup>
              <mml:mi>e</mml:mi>
              <mml:mrow>
                <mml:mi>i</mml:mi>
                <mml:mi>π</mml:mi>
              </mml:mrow>
            </mml:msup>
            <mml:mo>+</mml:mo>
            <mml:mn>1</mml:mn>
            <mml:mo>=</mml:mo>
            <mml:mn>0</mml:mn>
          </mml:mrow>
        </mml:math>
      </inline-formula>
    </p>
    <p>
      2.
      <bold> Gaussian Integral</bold>
       
      <inline-formula>
        <tex-math>\int_{−\infty}^{ \infty} e^{−x2}dx =\sqrt\pi</tex-math>
        <mml:math display="inline">
          <mml:mrow>
            <mml:msubsup>
              <mml:mo>∫</mml:mo>
              <mml:mrow>
                <mml:mo>−</mml:mo>
                <mml:mo>∞</mml:mo>
              </mml:mrow>
              <mml:mo>∞</mml:mo>
            </mml:msubsup>
            <mml:msup>
              <mml:mi>e</mml:mi>
              <mml:mrow>
                <mml:mo>−</mml:mo>
                <mml:mi>x</mml:mi>
                <mml:mn>2</mml:mn>
              </mml:mrow>
            </mml:msup>
            <mml:mi>dx</mml:mi>
            <mml:mo>=</mml:mo>
            <mml:msqrt>
              <mml:mi>π</mml:mi>
            </mml:msqrt>
          </mml:mrow>
        </mml:math>
      </inline-formula>
    </p>
    <sec>
      <title>3.  Basel Problem (Riemann Zeta at 2)</title>
      <p>
        <inline-formula>
          <tex-math>\sum_{n=1}^{\infty} \frac{1}{n^{2}} =\frac{ \pi^{2}}{6}</tex-math>
          <mml:math display="inline">
            <mml:mrow>
              <mml:munderover>
                <mml:mo>∑</mml:mo>
                <mml:mrow>
                  <mml:mi>n</mml:mi>
                  <mml:mo>=</mml:mo>
                  <mml:mn>1</mml:mn>
                </mml:mrow>
                <mml:mo>∞</mml:mo>
              </mml:munderover>
              <mml:mfrac>
                <mml:mn>1</mml:mn>
                <mml:msup>
                  <mml:mi>n</mml:mi>
                  <mml:mn>2</mml:mn>
                </mml:msup>
              </mml:mfrac>
              <mml:mo>=</mml:mo>
              <mml:mfrac>
                <mml:msup>
                  <mml:mi>π</mml:mi>
                  <mml:mn>2</mml:mn>
                </mml:msup>
                <mml:mn>6</mml:mn>
              </mml:mfrac>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
      <p>
        4.
        <bold> Stirling’s Approximation</bold>
         
        <inline-formula>
          <tex-math>n! \approx\sqrt 2πn (\frac{n}{e} )n</tex-math>
          <mml:math display="inline">
            <mml:mrow>
              <mml:mi>n</mml:mi>
              <mml:mo>!</mml:mo>
              <mml:mo>≈</mml:mo>
              <mml:msqrt>
                <mml:mn>2</mml:mn>
              </mml:msqrt>
              <mml:mi>π</mml:mi>
              <mml:mi>n</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mfrac>
                <mml:mi>n</mml:mi>
                <mml:mi>e</mml:mi>
              </mml:mfrac>
              <mml:mo>)</mml:mo>
              <mml:mi>n</mml:mi>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
      <p>
        5.
        <bold> Fourier Transform</bold>
         ˆ 
        <inline-formula>
          <tex-math>f(ξ) = \int_{−\infty}^{ \infty} f(x) e^{−2πixξ}dx</tex-math>
          <mml:math display="inline">
            <mml:mrow>
              <mml:mi>f</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mi>ξ</mml:mi>
              <mml:mo>)</mml:mo>
              <mml:mo>=</mml:mo>
              <mml:msubsup>
                <mml:mo>∫</mml:mo>
                <mml:mrow>
                  <mml:mo>−</mml:mo>
                  <mml:mo>∞</mml:mo>
                </mml:mrow>
                <mml:mo>∞</mml:mo>
              </mml:msubsup>
              <mml:mi>f</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mi>x</mml:mi>
              <mml:mo>)</mml:mo>
              <mml:msup>
                <mml:mi>e</mml:mi>
                <mml:mrow>
                  <mml:mo>−</mml:mo>
                  <mml:mn>2</mml:mn>
                  <mml:mi>π</mml:mi>
                  <mml:mi>ix</mml:mi>
                  <mml:mi>ξ</mml:mi>
                </mml:mrow>
              </mml:msup>
              <mml:mi>dx</mml:mi>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
    </sec>
    <sec>
      <title>6.  Cauchy Integral Formula</title>
      <p>
        <inline-formula>
          <tex-math>\oint_{\gamma} f(a) = \frac{1}{2πi}</tex-math>
          <mml:math display="inline">
            <mml:mrow>
              <mml:msub>
                <mml:mo>∮</mml:mo>
                <mml:mi>γ</mml:mi>
              </mml:msub>
              <mml:mi>f</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mi>a</mml:mi>
              <mml:mo>)</mml:mo>
              <mml:mo>=</mml:mo>
              <mml:mfrac>
                <mml:mn>1</mml:mn>
                <mml:mrow>
                  <mml:mn>2</mml:mn>
                  <mml:mi>π</mml:mi>
                  <mml:mi>i</mml:mi>
                </mml:mrow>
              </mml:mfrac>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
      <p>
        <inline-formula>
          <tex-math>\frac{f(z)}{z −a } dz</tex-math>
          <mml:math display="inline">
            <mml:mrow>
              <mml:mfrac>
                <mml:mrow>
                  <mml:mi>f</mml:mi>
                  <mml:mo>(</mml:mo>
                  <mml:mi>z</mml:mi>
                  <mml:mo>)</mml:mo>
                </mml:mrow>
                <mml:mrow>
                  <mml:mi>z</mml:mi>
                  <mml:mo>−</mml:mo>
                  <mml:mi>a</mml:mi>
                </mml:mrow>
              </mml:mfrac>
              <mml:mi>dz</mml:mi>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
    </sec>
    <sec>
      <title>7.  Schr¨ odinger Equation (time-dependent)</title>
      <p>
        <inline-formula>
          <tex-math>Ψ(r, t) = ( −\frac{ℏ^{2}}{2m} \nabla^{2} + V (r, t) ) Ψ(r, t)</tex-math>
          <mml:math display="inline">
            <mml:mrow>
              <mml:mi>Ψ</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mi>r</mml:mi>
              <mml:mo>,</mml:mo>
              <mml:mi>t</mml:mi>
              <mml:mo>)</mml:mo>
              <mml:mo>=</mml:mo>
              <mml:mo>(</mml:mo>
              <mml:mo>−</mml:mo>
              <mml:mfrac>
                <mml:msup>
                  <mml:mi>ℏ</mml:mi>
                  <mml:mn>2</mml:mn>
                </mml:msup>
                <mml:mrow>
                  <mml:mn>2</mml:mn>
                  <mml:mi>m</mml:mi>
                </mml:mrow>
              </mml:mfrac>
              <mml:msup>
                <mml:mo>∇</mml:mo>
                <mml:mn>2</mml:mn>
              </mml:msup>
              <mml:mo>+</mml:mo>
              <mml:mi>V</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mi>r</mml:mi>
              <mml:mo>,</mml:mo>
              <mml:mi>t</mml:mi>
              <mml:mo>)</mml:mo>
              <mml:mo>)</mml:mo>
              <mml:mi>Ψ</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mi>r</mml:mi>
              <mml:mo>,</mml:mo>
              <mml:mi>t</mml:mi>
              <mml:mo>)</mml:mo>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
      <p>
        <inline-formula>
          <tex-math>iℏ\frac{\partial}{\partial t}</tex-math>
          <mml:math display="inline">
            <mml:mrow>
              <mml:mi>i</mml:mi>
              <mml:mi>ℏ</mml:mi>
              <mml:mfrac>
                <mml:mo>∂</mml:mo>
                <mml:mrow>
                  <mml:mo>∂</mml:mo>
                  <mml:mi>t</mml:mi>
                </mml:mrow>
              </mml:mfrac>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
    </sec>
    <sec>
      <title>8.  Riemann Zeta Function (functional equation)</title>
      <p>
        <inline-formula>
          <tex-math>ζ(s) = 2^{s}\pi^{s−1}sin (\frac{πs}{2} ) Γ(1 −s) ζ(1 −s)</tex-math>
          <mml:math display="inline">
            <mml:mrow>
              <mml:mi>ζ</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mi>s</mml:mi>
              <mml:mo>)</mml:mo>
              <mml:mo>=</mml:mo>
              <mml:msup>
                <mml:mn>2</mml:mn>
                <mml:mi>s</mml:mi>
              </mml:msup>
              <mml:msup>
                <mml:mi>π</mml:mi>
                <mml:mrow>
                  <mml:mi>s</mml:mi>
                  <mml:mo>−</mml:mo>
                  <mml:mn>1</mml:mn>
                </mml:mrow>
              </mml:msup>
              <mml:mi mathvariant="normal">sin</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mfrac>
                <mml:mrow>
                  <mml:mi>π</mml:mi>
                  <mml:mi>s</mml:mi>
                </mml:mrow>
                <mml:mn>2</mml:mn>
              </mml:mfrac>
              <mml:mo>)</mml:mo>
              <mml:mi>Γ</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mn>1</mml:mn>
              <mml:mo>−</mml:mo>
              <mml:mi>s</mml:mi>
              <mml:mo>)</mml:mo>
              <mml:mi>ζ</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mn>1</mml:mn>
              <mml:mo>−</mml:mo>
              <mml:mi>s</mml:mi>
              <mml:mo>)</mml:mo>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
    </sec>
    <sec>
      <title>9.  Navier–Stokes Equation (incompressible flow)</title>
      <p>
        <inline-formula>
          <tex-math>ρ (\frac{\partial u}{\partial t} + u \cdot\nabla u ) = −\nabla p + µ\nabla^{2}u + f</tex-math>
          <mml:math display="inline">
            <mml:mrow>
              <mml:mi>ρ</mml:mi>
              <mml:mo>(</mml:mo>
              <mml:mfrac>
                <mml:mrow>
                  <mml:mo>∂</mml:mo>
                  <mml:mi>u</mml:mi>
                </mml:mrow>
                <mml:mrow>
                  <mml:mo>∂</mml:mo>
                  <mml:mi>t</mml:mi>
                </mml:mrow>
              </mml:mfrac>
              <mml:mo>+</mml:mo>
              <mml:mi>u</mml:mi>
              <mml:mo>·</mml:mo>
              <mml:mo>∇</mml:mo>
              <mml:mi>u</mml:mi>
              <mml:mo>)</mml:mo>
              <mml:mo>=</mml:mo>
              <mml:mo>−</mml:mo>
              <mml:mo>∇</mml:mo>
              <mml:mi>p</mml:mi>
              <mml:mo>+</mml:mo>
              <mml:mi>µ</mml:mi>
              <mml:msup>
                <mml:mo>∇</mml:mo>
                <mml:mn>2</mml:mn>
              </mml:msup>
              <mml:mi>u</mml:mi>
              <mml:mo>+</mml:mo>
              <mml:mi>f</mml:mi>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
    </sec>
    <sec>
      <title>10.  Einstein Field Equations</title>
      <p>
        <inline-formula>
          <tex-math>G_{µν} + Λg_{µν} = \frac{8πG}{c^{4}} T^{µν}</tex-math>
          <mml:math display="inline">
            <mml:mrow>
              <mml:msub>
                <mml:mi>G</mml:mi>
                <mml:mrow>
                  <mml:mi>µ</mml:mi>
                  <mml:mi>ν</mml:mi>
                </mml:mrow>
              </mml:msub>
              <mml:mo>+</mml:mo>
              <mml:mi>Λ</mml:mi>
              <mml:msub>
                <mml:mi>g</mml:mi>
                <mml:mrow>
                  <mml:mi>µ</mml:mi>
                  <mml:mi>ν</mml:mi>
                </mml:mrow>
              </mml:msub>
              <mml:mo>=</mml:mo>
              <mml:mfrac>
                <mml:mrow>
                  <mml:mn>8</mml:mn>
                  <mml:mi>π</mml:mi>
                  <mml:mi>G</mml:mi>
                </mml:mrow>
                <mml:msup>
                  <mml:mi>c</mml:mi>
                  <mml:mn>4</mml:mn>
                </mml:msup>
              </mml:mfrac>
              <mml:msup>
                <mml:mi>T</mml:mi>
                <mml:mrow>
                  <mml:mi>µ</mml:mi>
                  <mml:mi>ν</mml:mi>
                </mml:mrow>
              </mml:msup>
            </mml:mrow>
          </mml:math>
        </inline-formula>
      </p>
    </sec>
